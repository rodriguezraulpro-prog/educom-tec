rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Products collection: readable by all public visitors, writable by admin/authenticated clients
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Categories collection: readable by all public visitors, writable by admin/authenticated clients
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // Site configuration (Profile, contact, WhatsApp, stats, skills): readable by all, writable by admin
    match /siteConfig/{configId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
